{
    "default": {
        "paths": [
            "src/tests/features/**/*.feature"
        ],
        "require": [
            "src/tests/hooks/hooks.ts",
            "src/tests/step-definitions/**/*.steps.ts"
        ],
        "requireModule": [
            "ts-node/register"
        ],
        "formatOptions": {
            "snippetInterface": "async-await"
        },
        "publishQuiet": true,
        "parallel": 3,
        "retry": 0,
        "dryRun": false,
        
        "format": [
            "progress-bar",
            "json:reports/cucumber-report.json",
            "html:reports/cucumber-report.html"
        ]
    }
}